{
  "productName": "一声",
  "version": "1.0.0",
  "identifier": "com.onetone.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": "python scripts/generate_onetone_icon.py"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "一声",
        "width": 760,
        "height": 820,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 680,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "tray_menu",
        "title": "",
        "url": "tray-menu.html",
        "width": 264,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/vosk/libvosk.dll": "resources/vosk/",
      "resources/vosk/libgcc_s_seh-1.dll": "resources/vosk/",
      "resources/vosk/libstdc++-6.dll": "resources/vosk/",
      "resources/vosk/libwinpthread-1.dll": "resources/vosk/"
    }
  }
}
