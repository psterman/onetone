{
  "productName": "OneTone",
  "version": "1.0.0",
  "identifier": "com.onetone.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src",
    "beforeDevCommand": "npm run serve",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OneTone",
        "width": 760,
        "height": 820,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 680,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:8796; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/vosk/libvosk.dll": "libvosk.dll",
      "resources/vosk/libgcc_s_seh-1.dll": "libgcc_s_seh-1.dll",
      "resources/vosk/libstdc++-6.dll": "libstdc++-6.dll",
      "resources/vosk/libwinpthread-1.dll": "libwinpthread-1.dll",
      "resources/vosk/vosk-model-small-cn-0.22/": "resources/vosk/vosk-model-small-cn-0.22/",
      "../scripts/cursor-hook-probe.js": "scripts/cursor-hook-probe.js",
      "../scripts/codex-hook-probe.js": "scripts/codex-hook-probe.js",
      "../scripts/claude-hook-probe.js": "scripts/claude-hook-probe.js",
      "../scripts/claude-statusline-probe.js": "scripts/claude-statusline-probe.js",
      "../scripts/agent-shell-hook-probe.js": "scripts/agent-shell-hook-probe.js",
      "../scripts/copilot-cli-hook-probe.js": "scripts/copilot-cli-hook-probe.js",
      "../scripts/gemini-hook-probe.js": "scripts/gemini-hook-probe.js",
      "../scripts/cline-hook-probe.js": "scripts/cline-hook-probe.js",
      "../scripts/roo-hook-probe.js": "scripts/roo-hook-probe.js",
      "../scripts/aider-notify-probe.js": "scripts/aider-notify-probe.js",
      "../scripts/opencode-onetone-plugin/": "scripts/opencode-onetone-plugin/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0Qzc5NTMxNjgxRTQ4MQpSV1NCNUlFV1UzbE1Da2R3MFY2MWQrVjg4SUZod3JXSE1OSjV1akQwM2tCTSsrbEZadzhMWVRtWAo=",
      "endpoints": [
        "https://github.com/psterman/onetone/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
