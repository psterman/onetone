{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "node \"./scripts/cursor-hook-probe.js\" --onetone-hook-id cursor-observer-v1" }
    ],
    "beforeSubmitPrompt": [
      { "command": "node \"./scripts/cursor-hook-probe.js\" --onetone-hook-id cursor-observer-v1" }
    ],
    "preToolUse": [
      { "command": "node \"./scripts/cursor-hook-probe.js\" --onetone-hook-id cursor-observer-v1" }
    ],
    "postToolUse": [
      { "command": "node \"./scripts/cursor-hook-probe.js\" --onetone-hook-id cursor-observer-v1" }
    ],
    "postToolUseFailure": [
      { "command": "node \"./scripts/cursor-hook-probe.js\" --onetone-hook-id cursor-observer-v1" }
    ],
    "afterFileEdit": [
      { "command": "node \"./scripts/cursor-hook-probe.js\" --onetone-hook-id cursor-observer-v1" }
    ],
    "subagentStart": [
      { "command": "node \"./scripts/cursor-hook-probe.js\" --onetone-hook-id cursor-observer-v1" }
    ],
    "subagentStop": [
      { "command": "node \"./scripts/cursor-hook-probe.js\" --onetone-hook-id cursor-observer-v1" }
    ],
    "afterAgentResponse": [
      { "command": "node \"./scripts/cursor-hook-probe.js\" --onetone-hook-id cursor-observer-v1" }
    ],
    "stop": [
      { "command": "node \"./scripts/cursor-hook-probe.js\" --onetone-hook-id cursor-observer-v1" }
    ],
    "sessionEnd": [
      { "command": "node \"./scripts/cursor-hook-probe.js\" --onetone-hook-id cursor-observer-v1" }
    ]
  }
}
