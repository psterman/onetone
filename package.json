{
  "name": "onetone",
  "private": true,
  "version": "1.0.0",
  "description": "一声 onetone — 硬件启动键到语音输入法快捷键的映射工具（Tauri + Rust）",
  "scripts": {
    "serve": "serve src -l 1420 --no-port-switching",
    "dev:labs": "powershell -NoProfile -Command \"$env:ONETONE_CODEX_MICRO_PROTOCOL='1'; npm run dev\"",
    "tauri": "tauri",
    "dev": "tauri dev",
    "prepare-vosk": "node scripts/ensure-vosk-cn-model.js",
    "prepare-mediapipe": "node scripts/ensure-mediapipe-face-landmarker.js",
    "prebuild": "node scripts/ensure-vosk-cn-model.js && node scripts/ensure-mediapipe-face-landmarker.js",
    "build": "tauri build",
    "test:habit-profile": "node scripts/reconcile-habit-profile.js",
    "test:home-alerts": "node scripts/test-home-workbench-alerts.js",
    "test:target-key-catalog": "node scripts/verify-target-key-catalog.mjs",
    "test:voice-acoustic": "node scripts/voice-acoustic-config.test.js && node scripts/voice-acoustic-matcher.test.js && node scripts/voice-acoustic-ui.test.js",
    "test:voice-acoustic:rust": "cargo test --test voice_acoustic_command --manifest-path src-tauri/Cargo.toml -- --nocapture",
    "test:voice-acoustic:all": "npm run test:voice-acoustic && npm run test:voice-acoustic:rust",
    "typecheck": "tsc --noEmit",
    "build:islands": "vite build",
    "dev:islands": "vite build --watch",
    "test:islands": "tsc --noEmit && node scripts/smoke-islands.mjs && node scripts/test-island-runtime.mjs && node scripts/test-island-ui.mjs && node scripts/test-voice-config.mjs && node scripts/test-mapping-island.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "serve": "^14.2.4",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
