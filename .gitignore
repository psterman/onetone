# Node (Tauri dev frontend server)
node_modules/

# React Islands 构建产物（Vite 输出到 src/assets/islands/，由 build:islands 生成，勿提交）
src/assets/islands/

# Rust / Tauri — Cargo 默认 target 与自定义 --target-dir（如 target-release-live、target-codex-check）
src-tauri/target*/
target/
dist/
build/
src-tauri/gen/

# 误在 src-tauri/ 下再套一层工程/target（错误 cwd 或 --target-dir）
src-tauri/src-tauri/

# Python 脚本缓存
__pycache__/
*.py[cod]
*$py.class

# 本地配置与日志（用户数据在 %APPDATA%）
settings.json
voice_input_settings.json
*.log
logs/
src-tauri/logs/

# Playwright CLI 本地审计快照（page yml / screenshot）
.playwright-cli/

# 本地 agent 审计 scratch
.jez/

# Agent 会话记忆（本地）
.workbuddy/

# Agent controller 临时 submodule 检出
.agentcontroller-tmp/

# 设计稿目录内 ephemeral 审计产出（已提交的 HTML 原型保留）
design-mock/habit-*

# 本地 AI agent / skills 安装产物
.agents/
.codex/skills/
skills-lock.json

# 编辑器与系统
.idea/
.vscode/
.cursor/
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.bak

# Vosk 大体积资源（本地保留；运行时 DLL 可提交）
src-tauri/resources/vosk/vosk-model-*/
src-tauri/resources/kws/sherpa-kws-zh-small/
src-tauri/resources/kws/downloads/
src-tauri/resources/vosk/vosk-win64-*/
src-tauri/resources/vosk/downloads/

# MediaPipe Face Landmarker（prepare-mediapipe 下载；勿提交大文件）
src/vendor/mediapipe/wasm/
src/vendor/mediapipe/*.task
src/vendor/mediapipe/vision_bundle.mjs
src/vendor/mediapipe/vision_bundle.mjs.map

# Hang / crash dumps (never commit)
*.dmp
*.hdmp
HangDumps/
CrashDumps/
scripts/hang-dumps/procdump.exe
scripts/hang-dumps/procdump64.exe

